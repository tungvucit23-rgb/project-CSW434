# Frontend only. No server/Firebase/private key is required in mock mode.
EXPO_PUBLIC_DATA_SOURCE=mock
# Web: localhost. Android emulator: http://10.0.2.2:4000. Physical device: reachable LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Chỉ cần khi build Android standalone và dùng Google Maps native.
# GOOGLE_MAPS_API_KEY=
# Chỉ bật khi prebuild APK demo dùng backend HTTP LAN. Production dùng HTTPS và false.
# ALLOW_HTTP_DEMO=true
