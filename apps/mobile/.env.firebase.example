# PLANNED ONLY: existing mobile currently reads API URL / DATA_SOURCE,
# not the Firebase variables below. Frontend owner must add an Auth provider.
EXPO_PUBLIC_DATA_SOURCE=api
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# Public Firebase client config; NEVER put a service-account/private key here.
EXPO_PUBLIC_FIREBASE_API_KEY=emulator-only-placeholder
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-di-chung
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-di-chung.firebaseapp.com
EXPO_PUBLIC_FIREBASE_APP_ID=public-app-id-placeholder
# Proposed custom env read by the future client connectAuthEmulator helper:
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://10.0.2.2:9099
# Web uses http://127.0.0.1:9099; a device uses a reachable dev-machine host.
# Production: remove emulator URL, use real public config and HTTPS API URL.
# Optional existing native map build configuration:
# GOOGLE_MAPS_API_KEY=
# ALLOW_HTTP_DEMO=false
