PORT=4000
# Current SQL/PGlite configuration. Planned Firebase configuration is in
# .env.firebase.example; those variables do not switch the current server to Firestore.
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Empty DATABASE_URL uses local persistent PostgreSQL-compatible PGlite.
DATABASE_URL=
PGLITE_DATA_DIR=.data
# Replace with a cryptographically random value before any shared deployment.
# Without JWT_SECRET, development generates and persists a local secret in .data.
JWT_SECRET=
ALLOW_DEMO=true
SEED_DEMO=true
WEATHERAPI_KEY=
TOMORROW_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional for an OpenAI-compatible development test endpoint. Default is real OpenAI.
OPENAI_BASE_URL=https://api.openai.com/v1
WEATHER_CACHE_MINUTES=15
WEATHER_POLL_MINUTES=5
# Worker only polls active LIVE trips. Manual checks available in both modes.
ENABLE_WORKER=true
