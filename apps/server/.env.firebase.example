# PLANNED ONLY: current SQL server does not initialize Firebase Admin.
# Backend developer must implement the Firebase bootstrap/repositories first.
# Copy only the relevant values into a private .env after that implementation.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
GOOGLE_CLOUD_PROJECT=demo-di-chung
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Cloud/dev credential file stays OUTSIDE this repository; unset for emulator.
# GOOGLE_APPLICATION_CREDENTIALS=C:/outside-repository/firebase-dev.json
# New proposed config for compatibility Firebase Auth REST login/register:
FIREBASE_WEB_API_KEY=emulator-only-placeholder
ALLOW_DEMO=true
SEED_DEMO=true
ENABLE_WORKER=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
WEATHERAPI_KEY=
TOMORROW_API_KEY=
WEATHER_CACHE_MINUTES=15
WEATHER_POLL_MINUTES=5
# Production: remove both emulator hosts, use ADC/IAM and a real project;
# ALLOW_DEMO=false, SEED_DEMO=false, HTTPS, reviewed CORS. Never reuse SQL JWT auth.
