{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:di-chung:planner-output:v1",
  "title": "Đi Chung planner output INITIAL / RAIN_CHANGE",
  "description": "Phản ánh validator Zod cuối. Các trường số được kiểm tra tiếp với database, travelMatrix và facts; schema không tự chứng minh lịch khả thi.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "items"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Không chứa số, khẳng định chắc chắn hoặc nhận xét/dự báo thời tiết."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "placeId",
          "startMinute",
          "endMinute",
          "reason",
          "factIds"
        ],
        "properties": {
          "placeId": {
            "type": "string"
          },
          "startMinute": {
            "type": "integer"
          },
          "endMinute": {
            "type": "integer"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 350,
            "description": "Nhận xét thời tiết phải khớp nguyên văn weatherReasonPolicy và điều kiện facts của khoảng tham quan; lý do khác chỉ dựa dữ kiện được cung cấp."
          },
          "factIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 12
          }
        }
      },
      "minItems": 1,
      "maxItems": 12
    }
  }
}
