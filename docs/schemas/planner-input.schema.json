{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:di-chung:planner-input:v1",
  "title": "Đi Chung planner input INITIAL / RAIN_CHANGE",
  "description": "Schema tài liệu của buildInput. Categories là phần preferences planner hiện sử dụng; quan hệ fact/place/quorum và thời gian do code kiểm tra thêm.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "demo",
    "timezone",
    "groupConstraints",
    "planningStartMinute",
    "fixedPrefixItems",
    "allowedPlaces",
    "currentPlan",
    "preferences",
    "computedWeather",
    "weatherReasonPolicy",
    "travelMatrix",
    "facts",
    "trigger"
  ],
  "properties": {
    "task": {
      "enum": [
        "INITIAL",
        "RAIN_CHANGE"
      ]
    },
    "demo": {
      "type": "boolean"
    },
    "timezone": {
      "const": "Asia/Ho_Chi_Minh"
    },
    "groupConstraints": {
      "$ref": "#/$defs/groupConstraints"
    },
    "planningStartMinute": {
      "type": "integer"
    },
    "fixedPrefixItems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fixedItem"
      }
    },
    "allowedPlaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/allowedPlace"
      }
    },
    "currentPlan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/currentItem"
      }
    },
    "preferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preference"
      }
    },
    "computedWeather": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/weatherSlot"
      }
    },
    "travelMatrix": {
      "type": "object",
      "propertyNames": {
        "pattern": "^travel:"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/placeFact"
          },
          {
            "$ref": "#/$defs/travelFact"
          },
          {
            "$ref": "#/$defs/weatherFact"
          }
        ]
      }
    },
    "trigger": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/trigger"
        }
      ]
    },
    "weatherReasonPolicy": {
      "$ref": "#/$defs/weatherReasonPolicy"
    }
  },
  "$defs": {
    "groupConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "startMinute",
        "endMinute",
        "budgetPerPersonVnd",
        "remainingBudgetVnd"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "startMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1439
        },
        "endMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "budgetPerPersonVnd": {
          "type": "integer",
          "minimum": 0
        },
        "remainingBudgetVnd": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "allowedPlace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "environment",
        "openMinute",
        "closeMinute",
        "durationMin",
        "priceVnd",
        "factId",
        "dataQuality"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "environment": {
          "enum": [
            "INDOOR",
            "OUTDOOR"
          ]
        },
        "openMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1439
        },
        "closeMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "durationMin": {
          "type": "integer",
          "minimum": 1
        },
        "priceVnd": {
          "type": "integer",
          "minimum": 0
        },
        "factId": {
          "type": "string",
          "pattern": "^place:"
        },
        "dataQuality": {
          "type": "string"
        }
      }
    },
    "fixedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placeId",
        "startMinute",
        "endMinute",
        "reason",
        "factIds",
        "travelMin",
        "costVnd"
      ],
      "properties": {
        "placeId": {
          "type": "string"
        },
        "startMinute": {
          "type": "integer"
        },
        "endMinute": {
          "type": "integer"
        },
        "reason": {
          "type": "string"
        },
        "factIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "travelMin": {
          "type": "integer",
          "minimum": 0
        },
        "costVnd": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "currentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placeId",
        "startMinute",
        "endMinute"
      ],
      "properties": {
        "placeId": {
          "type": "string"
        },
        "startMinute": {
          "type": "integer"
        },
        "endMinute": {
          "type": "integer"
        }
      }
    },
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "placeFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "placeId",
        "environment",
        "openMinute",
        "closeMinute",
        "durationMin",
        "priceVnd"
      ],
      "properties": {
        "source": {
          "const": "database"
        },
        "placeId": {
          "type": "string"
        },
        "environment": {
          "enum": [
            "INDOOR",
            "OUTDOOR"
          ]
        },
        "openMinute": {
          "type": "integer"
        },
        "closeMinute": {
          "type": "integer"
        },
        "durationMin": {
          "type": "integer",
          "minimum": 1
        },
        "priceVnd": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "travelFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "minutes"
      ],
      "properties": {
        "source": {
          "const": "code:Haversine*1.3;25km/h;+5min;rounded5"
        },
        "minutes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "weatherFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "time",
        "rainMmH",
        "probabilityPct",
        "rainVotes",
        "validSources",
        "consensus"
      ],
      "properties": {
        "source": {
          "const": "normalized-provider-data"
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "rainMmH": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "probabilityPct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "rainVotes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "validSources": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "consensus": {
          "type": "boolean"
        }
      }
    },
    "weatherSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "time",
        "rainMmH",
        "probabilityPct",
        "rainVotes",
        "validSources",
        "consensus",
        "factId"
      ],
      "properties": {
        "source": {
          "const": "normalized-provider-data"
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "rainMmH": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "probabilityPct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "rainVotes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "validSources": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "consensus": {
          "type": "boolean"
        },
        "factId": {
          "type": "string",
          "pattern": "^weather:"
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placeId",
        "weatherFactId",
        "minutesAhead"
      ],
      "properties": {
        "placeId": {
          "type": "string"
        },
        "weatherFactId": {
          "type": "string",
          "pattern": "^weather:"
        },
        "minutesAhead": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        }
      }
    },
    "weatherReasonPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "RAIN_INDOOR",
        "UNKNOWN",
        "NO_CONSENSUS",
        "NEUTRAL"
      ],
      "properties": {
        "RAIN_INDOOR": {
          "const": "Ưu tiên không gian trong nhà vì các nguồn ghi nhận nguy cơ mưa."
        },
        "UNKNOWN": {
          "const": "Ưu tiên tính khả thi; chưa đủ nguồn thời tiết để xác nhận nguy cơ mưa."
        },
        "NO_CONSENSUS": {
          "const": "Các nguồn chưa ghi nhận đồng thuận nguy cơ mưa trong khung giờ dự kiến."
        },
        "NEUTRAL": {
          "const": "Phù hợp giờ mở cửa và khung thời tiết được cung cấp."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "const": "INITIAL"
          }
        }
      },
      "then": {
        "properties": {
          "fixedPrefixItems": {
            "maxItems": 0
          },
          "trigger": {
            "type": "null"
          }
        }
      }
    }
  ]
}
