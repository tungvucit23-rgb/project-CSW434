const migration=(path:string):[string,string]=>{
 if(path==='/health') return ['foundation/health','Firestore readiness'];
 if(path.startsWith('/auth/')) return ['auth + users','Firebase Authentication; users/{uid}'];
 if(path==='/cities') return ['catalogue/cities','cities/{cityId}'];
 if(path.startsWith('/places')) return ['catalogue/places','places/{placeId}'];
 if(path==='/ai/recommendations') return ['ai/discovery + facts','places; groups/preferences; weatherSnapshots; aiExecutions'];
 if(path==='/radar') return ['weather/radar','Provider metadata/cache; không có fake radar collection'];
 if(path.startsWith('/comments/')) return ['collaboration/comments','comments/{cid}; groups/members'];
 if(path.startsWith('/notifications')) return ['collaboration/notifications','users/{uid}/notifications/{nid}'];
 if(path.startsWith('/plans/')) return path.endsWith('/votes')?['plans/voting','plans/{pid}; plans/{pid}/votes/{uid}; groups; outbox']:['plans/read','plans/{pid}; votes; places'];
 if(path.includes('/preferences')) return ['groups/preferences','groups/{gid}/preferences/{uid}; groups/members'];
 if(path.includes('/wishlist')) return ['collaboration/wishlist','groups/{gid}/wishlist/{placeId}; places'];
 if(path.includes('/comments')) return ['collaboration/comments','comments; groups/members; wishlist/plans'];
 if(path.endsWith('/plans/generate')) return ['ai/planner + plans','plans; votes; aiExecutions; groups; weatherSnapshots'];
 if(path.endsWith('/plans')) return ['plans/history','plans where groupId; places; votes'];
 if(path.includes('/weather')||path.includes('/demo/rain')) return ['weather/checks + workers','weatherSnapshots; weatherChecks; groups/alerts; plans; outbox'];
 if(path.endsWith('/rain-reports')) return ['weather/reports','rainReports; weatherChecks'];
 if(path.endsWith('/verification')) return ['weather/verification','forecastVerifications; rainReports; weatherChecks'];
 if(path.endsWith('/alerts')) return ['weather/alerts','groups/{gid}/alerts/{aid}; uniqueKeys'];
 if(path.endsWith('/activity')) return ['collaboration/activity','groups/{gid}/activity/{aid}'];
 return ['groups/membership','groups/{gid}; groups/{gid}/members/{uid}; preferences; uniqueKeys'];
};
